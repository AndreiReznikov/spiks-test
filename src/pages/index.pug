extends ../core/ui/layout/templates/default.pug
include ../components/logo/logo.pug
include ../components/search/search.pug
include ../components/slider/slider.pug
include ../components/checkbox-list/checkbox-list.pug

block title
  | Marketplace

block workarea
  main.main
    .main__logo-wrapper
      +logo()
    .main__search-wrapper
      +search({
        placeholder: "Search",
      })
    .main__slider-wrapper
      +slider()
    .main__checkbox-list-wrapper
      +checkbox-list({
        id: '0',
        title: "Classification",
        checkboxState: [
          {
            id: '00',
            text: "Vegetables",
            checked: false,
          },
          {
            id: '01',
            text: "Carbs",
            checked: false,
          },
          {
            id: '02',
            text: "Fats",
            checked: false,
          },
        ],
      })
      +checkbox-list({
        id: 1,
        title: "Classification",
        checkboxState: [
          {
            id: '10',
            text: "Vegetables",
            checked: false,
          },
          {
            id: '11',
            text: "Carbs",
            checked: false,
          },
          {
            id: '12',
            text: "Fats",
            checked: false,
          },
        ],
      })
    .main__badge-wrapper