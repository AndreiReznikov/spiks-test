extends ../core/ui/layout/templates/default.pug
include ../components/logo/logo.pug
include ../components/search/search.pug
include ../components/slider/slider.pug
include ../components/checkbox-list/checkbox-list.pug

block title
  | Marketplace

block workarea
  main.main
    .main__search-block
      .main__logo-wrapper
        +logo()
      .main__search-wrapper
        +search({
          placeholder: "Search",
        })
    .main__slider-wrapper
      +slider({
        className: 'slider-no-ui',
        title: 'Price Range',
        min: 0,
        max: 100,
      })
    .main__result-block
      .main__result-count 1034,5 Results
      .main__badge-wrapper
    .main__checkbox-list-wrapper
      .main__checkbox-list
        .main__checkbox-list-group
          +checkbox-list({
            id: '0',
            title: "Classification",
            isOpened: true,
            checkboxState: [
              {
                id: '00',
                text: "Vegetables",
                checked: true,
              },
              {
                id: '01',
                text: "Carbs",
                checked: false,
              },
              {
                id: '02',
                text: "Fats",
                checked: true,
              },
            ],
          })
        .main__checkbox-list-group
          +checkbox-list({
            id: '1',
            title: "Delivery Period",
            isOpened: true,
            checkboxState: [
              {
                id: '10',
                text: "1 h",
                checked: true,
              },
              {
                id: '11',
                text: "24 h",
                checked: false,
              },
              {
                id: '12',
                text: "Today",
                checked: false,
              },
              {
                id: '13',
                text: "Next Week",
                checked: false,
              },
            ],
          })
        .main__checkbox-list-group
          +checkbox-list({
            id: '2',
            title: "Size",
            isOpened: true,
            checkboxState: [
              {
                id: '20',
                text: "Huge",
                checked: true,
              },
              {
                id: '21',
                text: "Large",
                checked: false,
              },
              {
                id: '22',
                text: "Medium",
                checked: false,
              },
              {
                id: '23',
                text: "Small",
                checked: false,
              },
              {
                id: '24',
                text: "Tiny",
                checked: false,
              },
            ],
          })