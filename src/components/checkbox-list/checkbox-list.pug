mixin checkbox-list(options = {})
  -
    let listClass = 'checkbox-list';
      listClass += options.isOpened ? ' checkbox-list_opened' : '';

  div(class=listClass data-id=options.id)
    h3.checkbox-list__title=options.title
      span.checkbox-list__arrow
    ul.checkbox-list__list
      each state in options.checkboxState
        -
          const { id, text, checked } = state;

        li.checkbox-list__item(data-id=id)
          label.checkbox-list__item-label
            input.checkbox-list__item-input(type="checkbox" checked=checked)
            span.checkbox-list__item-custom-input
            span.checkbox-list__item-text=text