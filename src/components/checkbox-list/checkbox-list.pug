mixin checkbox-list(options = {})
  -
    let listClass = 'checkbox-list';
      listClass += options.isOpened ? ' checkbox-list_opened' : '';

  div(class=listClass)
    h3.checkbox-list__title=options.title
      span.checkbox-list__arrow
    ul.checkbox-list__list
      each state in options.checkboxState
        -
          const { text, checked } = state;

        li.checkbox-list__item
          .checkbox-list__button
            label.checkbox-list__button-label
              input.checkbox-list__button-input(type="checkbox" checked=checked)
              span.checkbox-list__button-custom-input
              span.checkbox-list__button-text=text